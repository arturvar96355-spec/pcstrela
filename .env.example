NODE_ENV=production
SITE_DOMAIN=pcstrela.ru
NEXT_PUBLIC_SITE_URL=https://pcstrela.ru
NEXT_PUBLIC_COMPANY_SHORT=ПК Стрела
PAYLOAD_SECRET=                     # openssl rand -hex 32
POSTGRES_PASSWORD=                  # openssl rand -hex 24
# SMTP почтового провайдера. Яндекс: smtp.yandex.ru и 465. REG.RU и другие: значения из настроек почтовой программы в панели
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=                          # пароль приложения Яндекс 360
SMTP_FROM=
SMTP_FROM_NAME=Сайт ПК Стрела
TELEGRAM_BOT_TOKEN=
WATERMARK_TEXT=ПК Стрела
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=ООО «ПК Стрела»
SEED_COMPANY_EMAIL=
SEED_NOTIFY_EMAIL=
